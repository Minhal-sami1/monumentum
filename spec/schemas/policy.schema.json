{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentloop.invalid/schemas/v0.1/policy.schema.json",
  "title": "Policy",
  "description": "The declared change envelope (.loop/policy.yaml, parsed). Normative for spec loop/v0.1.",
  "type": "object",
  "required": ["spec", "envelope", "protected"],
  "additionalProperties": false,
  "properties": {
    "spec": { "const": "loop/v0.1" },
    "envelope": {
      "type": "object",
      "required": ["context", "capability", "architecture"],
      "additionalProperties": false,
      "properties": {
        "context": { "$ref": "#/$defs/class_policy" },
        "capability": { "$ref": "#/$defs/class_policy" },
        "architecture": { "$ref": "#/$defs/class_policy" }
      }
    },
    "protected": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "contains": { "const": ".loop/**" },
      "description": "Glob patterns that are never valid change targets. MUST contain \".loop/**\" (invariant I1)."
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "enum": ["context", "capability", "architecture"] },
      "patternProperties": {
        "^(context|capability|architecture)$": { "$ref": "#/$defs/escalation_rule" }
      },
      "description": "Optional per-class autonomy escalation through a recorded track record."
    },
    "de_escalation": {
      "type": "object",
      "required": ["on_rollbacks", "window_days", "drop"],
      "additionalProperties": false,
      "properties": {
        "on_rollbacks": { "type": "integer", "minimum": 1 },
        "window_days": { "type": "integer", "minimum": 1 },
        "drop": { "type": "integer", "minimum": 1 }
      },
      "description": "Automatic autonomy drop on repeated rollbacks. The ratchet also turns down."
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "journal": { "const": "hash-chain" },
        "retain_days": { "type": "integer", "minimum": 1 }
      }
    },
    "ext": {
      "type": "object",
      "description": "Extension container. Implementations MUST place non-standard fields here."
    }
  },
  "$defs": {
    "class_policy": {
      "type": "object",
      "required": ["level", "gates", "targets_allow"],
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["L0", "L1", "L2", "L3"] },
        "gates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["evidence_required", "reproducible_check", "human_review"] }
        },
        "targets_allow": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "escalation_rule": {
      "type": "object",
      "required": ["to", "after"],
      "additionalProperties": false,
      "properties": {
        "to": { "enum": ["L1", "L2", "L3"] },
        "after": {
          "type": "object",
          "required": ["applied", "rollbacks_max", "window_days"],
          "additionalProperties": false,
          "properties": {
            "applied": { "type": "integer", "minimum": 1 },
            "rollbacks_max": { "type": "integer", "minimum": 0 },
            "window_days": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
